DATABASE_URL=postgres://vibehard:vibehard@localhost:5432/vibehard
SESSION_SECRET=replace-with-at-least-32-random-characters
INVITE_CODES=VIBE-INTERNAL-2026
PLATFORM_URL=http://localhost:3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
RUNNER_GATEWAY_URL=ws://127.0.0.1:8787/runner
DEFAULT_RUNNER_KEY=local-runner
RUNNER_ID=local-runner
RUNNER_NAME=Local Codex Runner
RUNNER_WORKSPACE_ROOT=/tmp/vibehard-workspaces
RUNNER_PLATFORM_URL=http://localhost:3000
RUNNER_REGISTRATION_TOKEN=change-me
RUNNER_SHARED_SECRET=
RUNNER_STATE_FILE=
RUNNER_CREDENTIAL_FILE=
# Linux 生产环境必须配置强隔离 wrapper；值为带 {codex}、{workspaceRoot}、{workspace} 占位符的 JSON 参数数组。
RUNNER_CODEX_WRAPPER=
# 只允许本地开发显式降级，生产环境不要开启。
RUNNER_ALLOW_WEAK_ISOLATION=false
CODEX_BIN=codex
CODEX_REQUEST_TIMEOUT_MS=30000
# 仅列出自研 provider 必须传给 Codex 子进程的环境变量名，逗号分隔。
CODEX_PROVIDER_ENV_ALLOWLIST=
# EDA project snapshots must live on a persistent volume in production.
EDA_DATA_ROOT=
# Absolute executable path, or leave empty to use kicad-cli from PATH.
KICAD_CLI_PATH=
